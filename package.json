{
  "name": "piastra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight Pi orchestration with Astra planning and milestone review",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "start:fork": "node scripts/start-fork.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start:agegr": "node scripts/start-agegr.mjs",
    "start:tau": "node scripts/start-tau.mjs",
    "install:cli": "node scripts/install-cli.mjs",
    "test:cli": "node --experimental-strip-types --test extensions/piastra/*.test.mjs",
    "test:fork": "node --experimental-strip-types --test extensions/piastra/*.test.mjs scripts/start-fork.test.mjs"
  },
  "dependencies": {
    "@agegr/pi-web": "0.9.1",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "pi-web-ui": "0.80.0",
    "proper-lockfile": "^4.1.2",
    "tau-mirror": "1.0.9"
  },
  "overrides": {
    "@agegr/pi-web": {
      "next": "16.3.3"
    },
    "express": {
      "qs": "6.16.0"
    }
  }
}
