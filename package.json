{
  "name": "@michaelt025/dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dispatch — Pi orchestration with Astra planning and milestone review",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "dispatch": "bin/dispatch.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "start:fork": "node scripts/start-fork.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start:agegr": "node scripts/start-agegr.mjs",
    "start:tau": "node scripts/start-tau.mjs",
    "install:cli": "node scripts/install-cli.mjs",
    "test": "node --experimental-strip-types --test \"extensions/piastra/*.test.mjs\" \"extensions/pi-worktree/*.test.mjs\" \"extensions/pi-queue/*.test.mjs\" \"extensions/pi-compact-transcript/*.test.mjs\" \"extensions/pi-atelier/tests/*.test.mjs\" \"extensions/pi-todo/tests/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:cli": "node --experimental-strip-types --test \"extensions/piastra/*.test.mjs\" \"extensions/pi-worktree/*.test.mjs\" \"extensions/pi-queue/*.test.mjs\" \"extensions/pi-compact-transcript/*.test.mjs\" \"extensions/pi-atelier/tests/*.test.mjs\" \"extensions/pi-todo/tests/*.test.mjs\" \"scripts/install-cli.test.mjs\"",
    "test:fork": "npm test",
    "test:integration": "node --experimental-strip-types --test tests/integration/fork-runtime.test.mjs"
  },
  "dependencies": {
    "@agegr/pi-web": "0.9.1",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "html-to-text": "10.0.1",
    "ipaddr.js": "2.5.0",
    "minimatch": "10.2.6",
    "pi-web-ui": "0.80.0",
    "proper-lockfile": "^4.1.2",
    "tau-mirror": "1.0.9"
  },
  "overrides": {
    "@agegr/pi-web": {
      "next": "16.3.3"
    },
    "express": {
      "qs": "6.16.0"
    }
  }
}
